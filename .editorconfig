# Shared editor settings so every editor formats files the same way.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces mean a line break in Markdown, so keep them.
trim_trailing_whitespace = false

[justfile]
indent_size = 4
