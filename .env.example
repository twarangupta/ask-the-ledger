# AskTheLedger environment template.
# Copy this file to .env (just setup does it for you), then change the values.
# .env is ignored by git. Never put real secrets in this example file.
# Later phases add more settings here (gateway, agent, LLM keys).

# PostgreSQL (local Docker container)
# This is the database superuser. It is only for setup and migrations.
# The app itself will use smaller, restricted roles created in Phase 1.
POSTGRES_USER=atl_superuser
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=asktheledger
# Port on YOUR computer. 5435 avoids clashing with other local Postgres servers.
# Inside Docker, Postgres still listens on its normal port 5432.
POSTGRES_PORT=5435

# Redis (local Docker container)
REDIS_PASSWORD=change-me-local-only
# Port on YOUR computer. 6380 avoids clashing with another local Redis.
REDIS_PORT=6380
